{
	// Cassini RPWS low rate survey, magnetic.  The same split as
	// Survey.json5, which has the reasoning: the DSDF's mfr param is MFR
	// bands and search coil sensors in one set,
	//
	//    mfr | ... | -mfr @ | set: NONE 1 2 3 Bx Bz
	//
	// and becomes a band list and a sensor list filling one flag, bands
	// first, so what is sent does not change: -mfr 12Bx.

	"dataset": "Cassini/RPWS/Survey_Magnetic",
	"dsdf": "sha256:3dec79f48e72d651",
	"ops": [
		// The split below counts on this element order
		{"op": "test", "path": "/interface/options/props/mfr/set/enum/2/value", "value": "3"},
		{"op": "test", "path": "/interface/options/props/mfr/set/enum/3/value", "value": "Bx"},
		{"op": "test", "path": "/protocol/httpParams/params/flags/mfr/prefix", "value": "-mfr "},
		{"op": "test", "path": "/protocol/httpParams/params/flags/mfr/subSep", "value": ""},
		{"op": "test", "path": "/protocol/httpParams/params/flags/mfr/enum", "value": ["1", "2", "3", "Bx", "Bz"]},

		{"op": "copy", "from": "/interface/options/props/mfr", "path": "/interface/options/props/mfr_bands", "before": "mfr"},
		{"op": "remove", "path": "/interface/options/props/mfr_bands/set/enum/4"},
		{"op": "remove", "path": "/interface/options/props/mfr_bands/set/enum/3"},
		{"op": "replace", "path": "/interface/options/props/mfr_bands/label", "value": "MFR bands"},
		{"op": "replace", "path": "/interface/options/props/mfr_bands/title", "value": "MFR bands to output"},
		{"op": "move", "from": "/interface/options/props/mfr", "path": "/interface/options/props/mfr_sensors"},
		{"op": "remove", "path": "/interface/options/props/mfr_sensors/set/enum/2"},
		{"op": "remove", "path": "/interface/options/props/mfr_sensors/set/enum/1"},
		{"op": "remove", "path": "/interface/options/props/mfr_sensors/set/enum/0"},
		{"op": "replace", "path": "/interface/options/props/mfr_sensors/label", "value": "MFR sensors"},
		{"op": "replace", "path": "/interface/options/props/mfr_sensors/title", "value": "MFR sensors to output"},

		// Captions
		{"op": "replace", "path": "/interface/options/props/bg_div/label", "value": "Background division"},
		{"op": "replace", "path": "/interface/options/props/lfdr/label", "value": "LFDR sensors"},
		{"op": "replace", "path": "/interface/options/props/mfdr/label", "value": "MFDR sensors"},
		{"op": "replace", "path": "/interface/options/props/nix/label", "value": "Remove"},
	]
}
