{
	// Das Federated Catalog (FedCat) Node Definition
	//
	//   SourceSet (0.2)
	//
	// A catalog whose children all provide the same data via different
	// sources (das2 stream, das3 stream, ...).  Clients pick one child,
	// typically by its 'provides' MIME types.  The coords and data members
	// summarize what every child offers so a browser can show the dataset
	// without loading the sources themselves.  Shape follows what dasflex
	// emits (util/catalog.py).

	"$schema":"http://json-schema.org/draft/2020-12/schema",

	// Sources refer to each other by file name.  The build copies what a
	// schema uses into the published file (src/scripts/schema_bundle.py), and
	// gives that file its version as its id.
	"$id":"sourceset.json",

	"$ref":"node.json",  // All nodes have these properties

	"title":"A set of data sources that provide the same data",

	"type":"object",

	"properties":{
		"type":{"const":"SourceSet"},

		"catalog":{
			"type":"object",
			"additionalProperties":{"$ref":"node.json#/$defs/Child"}
		},

		"separator":{
			// One to seven of these characters and nothing else.  Seven is
			// what das2C reads; "/", ":/" and "://" are what is in use.
			"type":["null", "string"], "maxLength":7, "pattern":"^[:/\\.,;]+$",
			"default":"/"
		},

		// Summary of the coordinate and data dimensions, keyed by dimension
		// name, copied up from the children's interface sections
		"coords":{"$ref":"#/$defs/DimSummary"},
		"data":{"$ref":"#/$defs/DimSummary"},

		// Usually just the science contacts
		"contacts":{"$ref":"node.json#/$defs/Contacts"},

		// Terms of use, the same for every source in the set
		"usage":{"$ref":"node.json#/$defs/Usage"},

		// EPN-TAP core metadata for the dataset, by EPNcore column name
		// (target_name, dataproduct_type, ...), for VESPA style searches
		"EPNcore":{
			"type":"object",
			"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,62}$"},
			"additionalProperties":{"type":"string"}
		}
	},

	"required":["catalog"],

	"unevaluatedProperties": false,

	"$defs":{
		"DimSummary":{
			"type":"object",
			"additionalProperties":{
				"type":"object",
				"properties":{
					"label":{"type":"string"},
					"title":{"type":"string"},

					// Min and max, as ISO-8601 strings for time dimensions
					"validRange":{
						"type":"array", "minItems":2, "maxItems":2,
						"items":{"type":["string","number"]}
					}
				}
			}
		}
	}
}
