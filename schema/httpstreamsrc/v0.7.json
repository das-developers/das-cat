{
	"$schema": "http://json-schema.org/draft/2020-12/schema",
	"$id": "v0.7.json",
	"$ref": "node.json",
	"title": "Definition of a single transaction HTTP data endpoint",
	"type": "object",
	"properties": {
		"type": {
			"const": "HttpStreamSrc"
		},
		"contacts": {
			"$ref": "node.json#/$defs/Contacts"
		},
		"usage": {
			"$ref": "node.json#/$defs/Usage"
		},
		"protocol": {
			"type": "object",
			"properties": {
				"method": {
					"type": "string",
					"enum": [
						"GET",
						"POST"
					]
				},
				"convention": {
					"type": "string",
					"deprecated": true
				},
				"authorization": {
					"type": "object",
					"properties": {
						"required": {
							"type": "boolean"
						},
						"realm": {
							"type": "string"
						},
						"methods": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"address": {
							"type": "boolean"
						},
						"description": {
							"type": "string"
						}
					},
					"required": [
						"required"
					],
					"additionalProperties": false
				},
				"baseUrls": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/Url"
					}
				},
				"httpParams": {
					"type": "object",
					"additionalProperties": {
						"oneOf": [
							{
								"$ref": "#/$defs/ValueParam"
							},
							{
								"$ref": "#/$defs/FlagSetParam"
							}
						]
					}
				}
			},
			"required": [
				"method",
				"baseUrls"
			],
			"additionalProperties": false
		},
		"interface": {
			"type": "object",
			"properties": {
				"coords": {
					"$ref": "#/$defs/Groups"
				},
				"data": {
					"$ref": "#/$defs/Groups"
				},
				"formats": {
					"$ref": "#/$defs/Groups"
				},
				"options": {
					"$ref": "#/$defs/Group"
				},
				"examples": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Example"
					}
				}
			},
			"additionalProperties": false
		}
	},
	"required": [
		"protocol"
	],
	"unevaluatedProperties": false,
	"$defs": {
		"Url": {
			"type": "string",
			"format": "uri",
			"pattern": "^https?://"
		},
		"Ident": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
		},
		"Scalar": {
			"type": [
				"string",
				"number",
				"boolean"
			]
		},
		"Comment": {
			"type": "string",
			"minLength": 1
		},
		"ProtocolEnum": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": [
					"string",
					"number"
				]
			}
		},
		"Range": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"items": {
				"type": [
					"string",
					"number"
				]
			}
		},
		"ValueType": {
			"type": "string",
			"enum": [
				"isotime",
				"boolean",
				"string",
				"real",
				"integer",
				"enum",
				"bool",
				"int"
			]
		},
		"ValueParam": {
			"type": "object",
			"properties": {
				"type": {
					"$ref": "#/$defs/ValueType"
				},
				"required": {
					"type": "boolean"
				},
				"units": {
					"type": "string",
					"maxLength": 32
				},
				"enum": {
					"$ref": "#/$defs/ProtocolEnum"
				},
				"range": {
					"$ref": "#/$defs/Range"
				},
				"subSep": {
					"type": "string"
				},
				"repeat": {
					"type": "boolean"
				},
				"comment": {
					"$ref": "#/$defs/Comment"
				}
			},
			"not": {
				"required": [
					"subSep",
					"repeat"
				]
			},
			"additionalProperties": false
		},
		"FlagSetParam": {
			"type": "object",
			"properties": {
				"type": {
					"enum": [
						"FlagSet",
						"flag_set"
					]
				},
				"required": {
					"type": "boolean"
				},
				"flagSep": {
					"type": "string"
				},
				"comment": {
					"$ref": "#/$defs/Comment"
				},
				"flags": {
					"type": "object",
					"propertyNames": {
						"$ref": "#/$defs/Ident"
					},
					"additionalProperties": {
						"$ref": "#/$defs/Flag"
					}
				}
			},
			"required": [
				"type",
				"flags"
			],
			"additionalProperties": false
		},
		"Flag": {
			"type": "object",
			"properties": {
				"value": {
					"$ref": "#/$defs/Scalar"
				},
				"prefix": {
					"type": "string"
				},
				"suffix": {
					"type": "string"
				},
				"enum": {
					"$ref": "#/$defs/ProtocolEnum"
				},
				"subSep": {
					"type": "string"
				},
				"repeat": {
					"type": "boolean"
				},
				"comment": {
					"$ref": "#/$defs/Comment"
				},
				"type": {
					"type": "string",
					"deprecated": true
				}
			},
			"allOf": [
				{
					"not": {
						"required": [
							"subSep",
							"repeat"
						]
					}
				},
				{
					"not": {
						"required": [
							"value",
							"enum"
						]
					}
				},
				{
					"if": {
						"required": [
							"suffix"
						]
					},
					"then": {
						"required": [
							"prefix"
						]
					}
				}
			],
			"additionalProperties": false
		},
		"Groups": {
			"type": "object",
			"propertyNames": {
				"$ref": "#/$defs/Ident"
			},
			"additionalProperties": {
				"$ref": "#/$defs/Group"
			}
		},
		"Group": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 48
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"description": {
					"type": "string"
				},
				"props": {
					"type": "object",
					"propertyNames": {
						"$ref": "#/$defs/Ident"
					},
					"additionalProperties": {
						"$ref": "#/$defs/Property"
					}
				},
				"validRange": {
					"$ref": "#/$defs/Range"
				},
				"mimeTypes": {
					"type": "array",
					"items": {
						"type": "string",
						"maxLength": 64
					}
				},
				"order": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Ident"
					}
				}
			},
			"additionalProperties": false
		},
		"Property": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 48
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"description": {
					"type": "string"
				},
				"type": {
					"$ref": "#/$defs/ValueType"
				},
				"units": {
					"type": "string",
					"maxLength": 32
				},
				"value": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/Scalar"
						},
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/Scalar"
							},
							"uniqueItems": true
						}
					]
				},
				"multi": {
					"oneOf": [
						{
							"const": true
						},
						{
							"type": "array",
							"minItems": 2,
							"maxItems": 2,
							"items": {
								"type": "integer",
								"minimum": 0
							}
						}
					]
				},
				"xorGroup": {
					"$ref": "#/$defs/Ident"
				},
				"set": {
					"$ref": "#/$defs/SetBlock"
				}
			},
			"allOf": [
				{
					"if": {
						"required": [
							"multi"
						]
					},
					"then": {
						"properties": {
							"value": {
								"type": [
									"array",
									"null"
								]
							},
							"type": {
								"not": {
									"enum": [
										"boolean",
										"bool"
									]
								}
							}
						}
					},
					"else": {
						"properties": {
							"value": {
								"not": {
									"type": "array"
								}
							}
						}
					}
				}
			],
			"additionalProperties": false
		},
		"SetBlock": {
			"type": "object",
			"properties": {
				"param": {
					"type": "string",
					"minLength": 1
				},
				"flag": {
					"$ref": "#/$defs/Ident"
				},
				"required": {
					"type": "boolean"
				},
				"value": {
					"type": "boolean"
				},
				"pval": {
					"$ref": "#/$defs/Scalar"
				},
				"enum": {
					"type": "array",
					"minItems": 1,
					"items": {
						"oneOf": [
							{
								"$ref": "#/$defs/Scalar"
							},
							{
								"$ref": "#/$defs/EnumItem"
							}
						]
					}
				},
				"range": {
					"$ref": "#/$defs/Range"
				}
			},
			"required": [
				"param"
			],
			"additionalProperties": false
		},
		"EnumItem": {
			"type": "object",
			"properties": {
				"value": {
					"$ref": "#/$defs/Scalar"
				},
				"pval": {
					"$ref": "#/$defs/Scalar"
				},
				"flag": {
					"$ref": "#/$defs/Ident"
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 48
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"description": {
					"type": "string"
				}
			},
			"required": [
				"value"
			],
			"additionalProperties": false
		},
		"Example": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"settings": {
					"type": "object",
					"propertyNames": {
						"pattern": "^((coords|data|formats)/[A-Za-z_][A-Za-z0-9_]{0,62}/props|options/props)/[A-Za-z_][A-Za-z0-9_]{0,62}$"
					},
					"additionalProperties": {
						"oneOf": [
							{
								"$ref": "#/$defs/Scalar"
							},
							{
								"type": "array",
								"items": {
									"$ref": "#/$defs/Scalar"
								},
								"uniqueItems": true
							}
						]
					}
				}
			},
			"required": [
				"settings"
			],
			"additionalProperties": false
		},
		"catobj.json": {
			"$id": "catobj.json",
			"title": "CatObj",
			"description": "All JSON nodes and references have these properties",
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"Catalog",
						"SpdfMasterCat",
						"SpaseCatalog",
						"SourceSet",
						"HttpStreamSrc",
						"WebSockSrc",
						"Das2DSDF"
					]
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 48
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 48,
					"deprecated": true
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"description": {
					"type": "string",
					"minLength": 3,
					"maxLength": 8192
				}
			},
			"anyOf": [
				{
					"required": [
						"name",
						"type"
					]
				},
				{
					"required": [
						"label",
						"type"
					]
				}
			]
		},
		"node.json": {
			"$id": "node.json",
			"$ref": "catobj.json",
			"title": "Node",
			"description": "All JSON nodes have these properties",
			"type": "object",
			"properties": {
				"$schema": {
					"type": "string",
					"format": "uri",
					"pattern": "^https?://"
				},
				"version": {
					"type": "string",
					"pattern": "^[0-9][0-9]{0,2}\\.[0-9][0-9]{0,2}(\\.[0-9][0-9]{0,2})?$"
				},
				"token": {
					"type": "string",
					"pattern": "^[a-z_][a-z0-9_]{0,32}$"
				}
			},
			"$defs": {
				"Child": {
					"$ref": "catobj.json",
					"if": {
						"anyOf": [
							{
								"required": [
									"urls"
								]
							},
							{
								"required": [
									"locations"
								]
							}
						]
					},
					"then": {
						"$ref": "reference.json"
					}
				},
				"Contacts": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"minLength": 1,
								"maxLength": 32
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"email": {
								"type": "string"
							}
						},
						"required": [
							"name",
							"type"
						],
						"additionalProperties": false
					}
				},
				"Usage": {
					"type": "object",
					"properties": {
						"policy": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"url": {
							"type": "string",
							"format": "uri",
							"pattern": "^https?://"
						}
					},
					"additionalProperties": false
				}
			}
		},
		"reference.json": {
			"$id": "reference.json",
			"$ref": "catobj.json",
			"title": "A reference to a complete node",
			"type": "object",
			"properties": {
				"externalDesc": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Url"
					}
				},
				"mime": {
					"type": "string",
					"maxLength": 64,
					"default": "application/json"
				},
				"MIME": {
					"type": "string",
					"maxLength": 64,
					"deprecated": true
				},
				"provides": {
					"type": "array",
					"items": {
						"type": "string",
						"maxLength": 64
					}
				},
				"purpose": {
					"type": "string",
					"maxLength": 32
				},
				"locations": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Location"
					}
				},
				"urls": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Url"
					},
					"deprecated": true
				}
			},
			"anyOf": [
				{
					"required": [
						"label",
						"type",
						"locations"
					]
				},
				{
					"required": [
						"name",
						"type",
						"locations"
					]
				},
				{
					"required": [
						"label",
						"type",
						"urls"
					]
				},
				{
					"required": [
						"name",
						"type",
						"urls"
					]
				}
			],
			"unevaluatedProperties": false,
			"$defs": {
				"Url": {
					"type": "string",
					"format": "uri",
					"pattern": "^https?://"
				},
				"Location": {
					"type": "object",
					"properties": {
						"url": {
							"$ref": "#/$defs/Url"
						},
						"authReq": {
							"type": "boolean",
							"default": false
						},
						"addressReq": {
							"type": "boolean",
							"default": false
						}
					},
					"required": [
						"url"
					]
				}
			}
		}
	}
}
