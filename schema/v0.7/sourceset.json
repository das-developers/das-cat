{
	"$schema": "http://json-schema.org/draft/2020-12/schema",
	"$id": "sourceset.json",
	"$ref": "node.json",
	"title": "A set of data sources that provide the same data",
	"type": "object",
	"properties": {
		"type": {
			"const": "SourceSet"
		},
		"catalog": {
			"type": "object",
			"additionalProperties": {
				"$ref": "catalog.json#/$defs/Child"
			}
		},
		"separator": {
			"type": [
				"null",
				"string"
			],
			"maxLength": 16,
			"pattern": "[:/\\.,;]+",
			"default": "/"
		},
		"coords": {
			"$ref": "#/$defs/DimSummary"
		},
		"data": {
			"$ref": "#/$defs/DimSummary"
		},
		"contacts": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"email": {
						"type": "string"
					}
				},
				"required": [
					"name",
					"type"
				]
			}
		}
	},
	"required": [
		"catalog"
	],
	"unevaluatedProperties": false,
	"$defs": {
		"DimSummary": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string"
					},
					"validRange": {
						"type": "array",
						"minItems": 2,
						"maxItems": 2,
						"items": {
							"type": [
								"string",
								"number"
							]
						}
					}
				}
			}
		}
	}
}
