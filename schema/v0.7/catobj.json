{
	"$schema": "http://json-schema.org/draft/2020-12/schema",
	"$id": "catobj.json",
	"title": "CatObj",
	"description": "All JSON nodes and references have these properties",
	"type": "object",
	"properties": {
		"type": {
			"type": "string",
			"enum": [
				"Catalog",
				"SpdfMasterCat",
				"SpaseCatalog",
				"SourceSet",
				"HttpStreamSrc",
				"WebSockSrc",
				"Das2DSDF"
			]
		},
		"label": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32,
			"deprecated": true
		},
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"description": {
			"type": "string",
			"minLength": 3,
			"maxLength": 8192
		}
	},
	"anyOf": [
		{
			"required": [
				"name",
				"type"
			]
		},
		{
			"required": [
				"label",
				"type"
			]
		}
	]
}
